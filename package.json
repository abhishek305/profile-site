    "version": "3.0.0",
    "description": "A path-based, interactive portfolio with four playable project stages. React, TypeScript and Vite, statically prerendered.",
    "license": "MIT",
    "author": "Abhishek Ezhava",
    "homepage": "https://profile-site-navy-pi.vercel.app",
    "repository": {
